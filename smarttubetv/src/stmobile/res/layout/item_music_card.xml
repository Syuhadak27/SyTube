<?xml version="1.0" encoding="utf-8"?>
<!-- One square-artwork card in a music shelf (song, mix, playlist or artist). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_card_root"
    android:layout_width="148dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/music_card_art_frame"
            android:layout_width="148dp"
            android:layout_height="148dp"
            app:cardBackgroundColor="@color/mobile_color_placeholder"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/music_card_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/music_card_badge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_video_badge"
                android:contentDescription="@string/mobile_music_playlist"
                android:padding="5dp"
                android:src="@drawable/ic_music_playlist"
                android:visibility="gone"
                tools:visibility="visible" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/music_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="1sp"
            android:maxLines="2"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="14sp"
            tools:text="Song title that can wrap onto two lines" />

        <TextView
            android:id="@+id/music_card_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="12sp"
            tools:text="Artist" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
