<?xml version="1.0" encoding="utf-8"?>
<!-- Docked YouTube-Music-style now-playing strip over the music shelves. It only reads the
     mini-player bridge (artwork + transport); the playback Activity keeps owning the player. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/music_now_playing"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_music_now_playing"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/mobile_color_placeholder"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/music_now_playing_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/music_now_playing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="14sp"
                tools:text="Now playing" />

            <TextView
                android:id="@+id/music_now_playing_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="12sp"
                tools:text="Artist" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/music_now_playing_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_music_play_pause"
            android:padding="12dp"
            android:src="@drawable/ic_player_pause" />

        <ImageButton
            android:id="@+id/music_now_playing_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_music_close"
            android:padding="14dp"
            android:src="@drawable/ic_sheet_close"
            app:tint="@color/mobile_color_on_surface_secondary" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/music_now_playing_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="1000"
        android:progressBackgroundTint="@color/mobile_color_track"
        android:progressTint="@color/mobile_color_primary" />

</LinearLayout>
