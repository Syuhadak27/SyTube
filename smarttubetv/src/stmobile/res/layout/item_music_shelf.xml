<?xml version="1.0" encoding="utf-8"?>
<!-- One horizontal music shelf: section title + a sideways-scrolling row of square cards. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/music_shelf_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Made for you" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/music_shelf_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:scrollbars="none"
        tools:listitem="@layout/item_music_card" />

</LinearLayout>
