<?xml version="1.0" encoding="utf-8"?>
<!--
  SyTube Music - a YouTube-Music-style home: a warm hero header followed by sideways-scrolling
  shelves of square artwork cards (songs, mixes, playlists, artists), a sign-in / empty / error
  state over the content, and a docked now-playing strip while the mini player is alive.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_color_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mobile_music_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="@color/mobile_color_background"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/mobile_music_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_back"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_back_arrow" />

        <TextView
            android:id="@+id/mobile_music_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="16dp"
            android:text="@string/mobile_music_title"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.newtube.mobile.ui.common.HapticSwipeRefreshLayout
            android:id="@+id/mobile_music_swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/mobile_music_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <!-- Hero: a soft crimson wash with a music-note disc and a time-of-day greeting. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_music_hero"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_music_icon_circle">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_mobile_music"
                                app:tint="@android:color/white" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/mobile_music_greeting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textColor="@color/mobile_color_on_surface"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            tools:text="Good evening" />

                        <TextView
                            android:id="@+id/mobile_music_hero_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/mobile_music_subtitle"
                            android:textColor="@color/mobile_color_on_surface_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Shelves are inflated here (item_music_shelf.xml), one per music row. -->
                    <LinearLayout
                        android:id="@+id/mobile_music_shelves"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </com.newtube.mobile.ui.common.HapticSwipeRefreshLayout>

        <!-- Sign-in / empty / error page, over the shelves (which keep their content). -->
        <LinearLayout
            android:id="@+id/mobile_music_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/mobile_color_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ProgressBar
                android:id="@+id/mobile_music_state_progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/mobile_color_primary"
                android:indeterminateTintMode="src_in" />

            <ImageView
                android:id="@+id/mobile_music_state_icon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mobile_empty"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mobile_music_state_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Sign in to listen"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/mobile_music_state_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Your liked songs, mixes and playlists appear here."
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_music_state_action"
                style="@style/Widget.NewTube.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                tools:text="Sign in"
                tools:visibility="visible" />

        </LinearLayout>

    </FrameLayout>

    <include layout="@layout/mobile_music_now_playing" />

</LinearLayout>
