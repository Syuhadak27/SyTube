<?xml version="1.0" encoding="utf-8"?>
<!-- Docked now-playing bar: a raised surface strip with a hairline top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_color_divider" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_color_surface" />
        </shape>
    </item>
</layer-list>
